  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:export": "tsx scripts/assets.ts export",
    "assets:validate": "tsx scripts/assets.ts validate",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:android": "expo export --platform android --output-dir dist-android",
