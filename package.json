    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
